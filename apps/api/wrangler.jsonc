{
  // Arai Worker: serves the SPA (assets) and /api on one origin.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The SPA build is served as static assets; only /api/* runs the Worker.
  // Static responses get security headers from apps/web/public/_headers.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arai",
      // Production D1 database (ids are not secret).
      "database_id": "a78a613a-439a-4551-8443-eda83662f32c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FEATURE_EMAIL": "off",
    "FEATURE_SMS": "off",
    "REQUIRE_TURNSTILE": "false"
  }
  // Secrets (wrangler secret put / .dev.vars, never committed):
  // AUTH_PEPPER, KDF_SALT_SECRET, IP_HMAC_SECRET, optional TURNSTILE_SECRET
}
